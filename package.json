{
  "name": "kult-sports-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Kult Sports web game: an isometric pixel-art football analysis agency on the Pixel Agency API.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "npm run build:privy && npm run build:minds",
    "recolor": "node scripts/recolor.mjs",
    "build:privy": "vite build --config privy-login/vite.config.js",
    "build:minds": "vite build --config minds-login/vite.config.js"
  },
  "devDependencies": {
    "@privy-io/react-auth": "^3.35.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "vite": "^7.3.1",
    "@animocabrands/minds-connect": "0.1.2"
  }
}
